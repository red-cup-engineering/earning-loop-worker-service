diff --git a/src/hashn-acquisition.mjs b/src/hashn-acquisition.mjs
new file mode 100644
index 0000000..c07435c
--- /dev/null
+++ b/src/hashn-acquisition.mjs
@@ -0,0 +1,113 @@
+import { canonicalJson } from '@red-cup-engineering/json-services-section/canonical-json';
+import { hashnCredential, hashnError, hashnRequest, UUID } from './hashn-client.mjs';
+
+export const HASHN_STATE = 'hashn/acquisition';
+export const HASHN_SUMMARY = 'hashn/public-summary';
+const AUTH = 'hashn/auth';
+const SIX_HOURS = 6 * 60 * 60 * 1000;
+const WEEK = 7 * 24 * 60 * 60 * 1000;
+const hash = async value => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(canonicalJson(value)))), n => n.toString(16).padStart(2,'0')).join('');
+
+export function hashnInstanceProblem(instance) {
+  if (!instance?.enabled) return 'hashn-disabled';
+  if (!UUID.test(instance.workspaceId ?? '') || !UUID.test(instance.buyerAgentId ?? '') ||
+    !/^[a-zA-Z0-9_-]{1,100}$/.test(instance.offerId ?? '') || typeof instance.note !== 'string' ||
+    [...instance.note].length < 1 || [...instance.note].length > 500 || /[\u0000-\u0008\u000b\u000c\u000e-\u001f]/.test(instance.note) ||
+    instance.maximumNewCashExpenseUsd !== 0 || instance.maximumProviderRequestsPerPass !== 3 ||
+    instance.pollIntervalMs !== SIX_HOURS) return 'hashn-instance-refused';
+  return null;
+}
+
+/** The caller is the existing singleton DO queue. This operation can only send
+ * one frozen knock and observe its disposition. A response is never an agreement
+ * or delivery instruction. Token, note, replies and workspace ids stay private. */
+export async function runHashnAcquisition({ storage, instance, initialCredential, fetchImpl = fetch, now = () => Date.now() } = {}) {
+  const refusal = hashnInstanceProblem(instance);
+  if (refusal) return { stage: refusal, requests: 0, newCashExpenseUsd: 0 };
+  let state = await storage.get(HASHN_STATE) ?? {};
+  let calls = 0;
+  const finish = async (stage, terminal = false, delay = SIX_HOURS) => {
+    state.stage = stage; state.terminal = terminal;
+    state.nextAttemptAt = terminal || state.retryBlocked ? null : Math.max(now() + delay, state.retryAt ?? 0);
+    await storage.put(HASHN_STATE, state);
+    const summary = { stage, requests: calls, newCashExpenseUsd: 0, at: new Date(now()).toISOString(),
+      offerId: instance.offerId, knockStatus: state.knockStatus ?? null,
+      agreementReceived: false, deliverySubmitted: false, recognizedOutsideRevenue: null };
+    await storage.put(HASHN_SUMMARY, summary);
+    return summary;
+  };
+  const wire = async (path, options = {}) => {
+    if (calls >= instance.maximumProviderRequestsPerPass) throw hashnError('hashn-request-budget');
+    if (state.retryBlocked || state.retryAt > now()) throw hashnError('hashn-retry-deferred');
+    calls++;
+    return hashnRequest(path, { ...options, fetchImpl, now, onRetry: async retry => {
+      Object.assign(state,retry); await storage.put(HASHN_STATE,state);
+    } });
+  };
+  try {
+    const credential = hashnCredential(initialCredential);
+    if (!credential) return finish('hashn-credential-held');
+    const bound = { agentId: credential.agentId, workspaceId: instance.workspaceId,
+      buyerAgentId: instance.buyerAgentId, offerId: instance.offerId, note: instance.note };
+    const binding = await hash(bound);
+    if (state.binding && state.binding !== binding) return finish('hashn-binding-drift',true);
+    const priorAuth = await storage.get(AUTH);
+    if (priorAuth && (priorAuth.agentId !== credential.agentId || priorAuth.apiToken !== credential.apiToken)) return finish('hashn-credential-drift',true);
+    if (state.terminal) return finish(state.stage,true);
+    if (state.retryBlocked || state.nextAttemptAt > now()) return { stage: state.stage, requests: 0, newCashExpenseUsd: 0 };
+    if (state.monitoringUntil && now() >= state.monitoringUntil) return finish('hashn-reconciliation-deadline-held',true);
+    if (!priorAuth) {
+      const { data } = await wire('/agents/me',{credential});
+      if ((data.agent_id ?? data.id) !== credential.agentId) return finish('hashn-account-mismatch',true);
+      await storage.put(AUTH,credential);
+    }
+    state.binding ??= binding;
+    state.scope ??= bound;
+    if (state.intent && !state.reconciliationAttempted) state.reconciliationAttempted = true;
+    await storage.put(HASHN_STATE,state);
+    const { data, providerReceipt } = await wire('/knocks',{credential});
+    state.knocksReadbackReceipt = providerReceipt;
+    // Provider OpenAPI deliberately leaves this response untyped. Admit only
+    // its independently received outgoing shape; never infer absence otherwise.
+    if (!Array.isArray(data.outgoing)) throw hashnError('hashn-knocks-shape-held');
+    if (data.has_more === true || data.next_cursor || data.nextCursor) throw hashnError('hashn-knocks-truncated-held');
+    if (data.outgoing.some(k => !k || !UUID.test(k.workspace_id ?? ''))) throw hashnError('hashn-knocks-shape-held');
+    const related = data.outgoing.filter(k => k.workspace_id === instance.workspaceId);
+    if (related.length > 1) return finish('hashn-knock-conflict-held',true);
+    const knock = related[0];
+    if (knock) {
+      if (!['knock_id','from_agent_id','to_agent_id','note','status'].every(key => Object.hasOwn(knock,key)))
+        return finish('hashn-knock-shape-held');
+      if (!UUID.test(knock.knock_id ?? '') || knock.from_agent_id !== credential.agentId ||
+          knock.to_agent_id !== instance.buyerAgentId || knock.note !== instance.note ||
+          !['pending','accepted','declined','expired'].includes(knock.status)) return finish('hashn-knock-scope-held',true);
+      if (state.knockId && state.knockId !== knock.knock_id) return finish('hashn-knock-identity-held',true);
+      state.knockId = knock.knock_id; state.knockStatus = knock.status;
+      state.monitoringUntil ??= now() + WEEK + SIX_HOURS;
+      if (knock.status === 'accepted') {
+        if (!UUID.test(knock.result_workspace_id ?? '')) return finish('hashn-acceptance-shape-held',true);
+        state.resultWorkspaceId = knock.result_workspace_id;
+        return finish('hashn-accepted-terms-held',true);
+      }
+      return finish('hashn-' + knock.status, knock.status !== 'pending');
+    }
+    if (state.intent) return finish('hashn-knock-readback-pending'); // absolutely no POST replay after uncertainty/absence
+    state.intent = { method: 'POST', path: `/workspaces/${instance.workspaceId}/knock`, body: { note: instance.note },
+      payloadSha256: await hash({ note: instance.note }), at: new Date(now()).toISOString() };
+    state.monitoringUntil = now() + WEEK + SIX_HOURS;
+    await storage.put(HASHN_STATE,state); // before the only permissible mutation
+    const result = await wire(state.intent.path,{method:'POST',body:state.intent.body,credential});
+    state.knockWriteReceipt = result.providerReceipt;
+    await storage.put(HASHN_STATE,state);
+    if (result.status !== 201) throw hashnError('hashn-knock-response-held');
+    // Even a successful write is reconciled from GET /knocks; raw provider
+    // response stays untrusted and is never exposed or treated as a deal.
+    return finish('hashn-knock-sent-readback-pending',false,30000);
+  } catch (e) {
+    const code = /^hashn-[a-z-]{1,80}$/.test(e.code ?? '') ? e.code : 'hashn-failure';
+    state.lastFailure = code;
+    if (e.providerReceipt) state.providerReceipt = e.providerReceipt;
+    return finish(code,[400,401,403,404,402,410,422].includes(e.status) || e.status === 409 && !state.intent || code === 'hashn-redirect-refused',
+      state.intent && !state.reconciliationAttempted ? 30000 : SIX_HOURS);
+  }
+}
diff --git a/src/hashn-client.mjs b/src/hashn-client.mjs
new file mode 100644
index 0000000..bc847f6
--- /dev/null
+++ b/src/hashn-client.mjs
@@ -0,0 +1,68 @@
+// Hashn 0.61.2 control API: fixed origin, no redirects or automatic replay.
+import { readTextBody } from '@red-cup-engineering/http-services-section/body/web';
+import { retryAfterDelayMs } from '@red-cup-engineering/http-services-section/retry-after';
+import { admitCanonicalJson, JSON_RESOURCE_ENVELOPE } from '@red-cup-engineering/json-services-section/canonical-json';
+
+export const HASHN_ORIGIN = 'https://api.hashn.com';
+export const UUID = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i;
+const LIMIT = 32768;
+const envelope = { ...JSON_RESOURCE_ENVELOPE, maxSourceBytes: LIMIT, maxCanonicalBytes: LIMIT, maxDepth: 20, maxNodes: 12000 };
+export const hashnError = (code, status = 0) => Object.assign(new Error(code), { code, status });
+export function privateHashnReceipt(value, credential) {
+  const redact = v => {
+    if (typeof v === 'string') return v.replace(/aw_[A-Za-z0-9._~-]+/g,'[redacted-token]')
+      .split(credential?.apiToken || '\u0000').join('[redacted-token]');
+    if (Array.isArray(v)) return v.map(redact);
+    if (v && typeof v === 'object') return Object.fromEntries(Object.entries(v).map(([k,x]) =>
+      [k,/authorization|token|secret|password|credential/i.test(k) ? '[redacted]' : redact(x)]));
+    return v;
+  };
+  const safe = redact(value);
+  if (new TextEncoder().encode(JSON.stringify(safe)).length > LIMIT)
+    return { status: safe.status, requestId: safe.requestId, cfRay: safe.cfRay, coverage: 'redacted-receipt-exceeds-storage-limit', bodyOmitted: true };
+  return safe;
+}
+export function hashnCredential(value) {
+  let c;
+  try { c = typeof value === 'string' ? JSON.parse(value) : value; } catch { return null; }
+  return UUID.test(c?.agentId ?? '') && typeof c.apiToken === 'string' && /^aw_[A-Za-z0-9_-]{8,512}$/.test(c.apiToken)
+    ? { agentId: c.agentId, apiToken: c.apiToken } : null;
+}
+
+export async function hashnRequest(path, { method = 'GET', body, credential, fetchImpl = fetch, now = () => Date.now(), onRetry = async () => {} } = {}) {
+  const allowed = method === 'GET' && ['/agents/me', '/knocks', '/listings'].includes(path) && credential ||
+    method === 'POST' && (path === '/agents' && !credential ||
+      (/^\/workspaces\/[a-f0-9-]{36}\/knock$/i.test(path) || ['/listings/check','/listings'].includes(path)) && credential);
+  if (!allowed) throw hashnError('hashn-endpoint-refused');
+  const signal = AbortSignal.timeout(15000);
+  let response;
+  try {
+    response = await fetchImpl(HASHN_ORIGIN + path, { method, redirect: 'manual', signal,
+      headers: { accept: 'application/json', ...(credential ? { authorization: `Bearer ${credential.apiToken}` } : {}),
+        ...(body === undefined ? {} : { 'content-type': 'application/json' }) },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+  } catch { throw Object.assign(hashnError('hashn-response-unknown'), { providerReceipt: { status: null, coverage: 'response-not-received' } }); }
+  const receipt = { status: response.status, requestId: response.headers.get('x-request-id')?.slice(0,256) ?? null,
+    cfRay: response.headers.get('cf-ray')?.slice(0,256) ?? null, coverage: 'headers-only' };
+  const refuse = code => Object.assign(hashnError(code,response.status), { providerReceipt: privateHashnReceipt(receipt,credential) });
+  const retry = response.headers.get('retry-after');
+  if (retry) {
+    const delay = retry.length <= 256 ? retryAfterDelayMs(retry, now()) : null;
+    const retryBlocked = retry.length > 256 || delay === null && /^\d+$/.test(retry.trim()) || delay !== null && !Number.isFinite(new Date(now() + delay).getTime());
+    if (retryBlocked || delay !== null) await onRetry({ retryBlocked, retryAt: retryBlocked ? null : now() + delay });
+  }
+  if (Number(response.headers.get('content-length')) > LIMIT) {
+    receipt.coverage = 'declared-body-too-large';
+    void response.body?.cancel().catch(() => {}); throw refuse('hashn-response-too-large');
+  }
+  let text;
+  try {
+    text = await readTextBody({ body: response.body, headers: response.headers, signal }, { maxBytes: LIMIT, decodeContentEncoding: false });
+  } catch { receipt.coverage = 'body-unreceived-or-limit'; throw refuse('hashn-response-invalid'); }
+  receipt.coverage = 'complete-bounded-body';
+  let data;
+  try { data = admitCanonicalJson(text, envelope).value; receipt.body = data; }
+  catch { receipt.body = text; if (response.ok) throw refuse('hashn-response-invalid'); }
+  if (!response.ok) throw refuse(response.status >= 300 && response.status < 400 ? 'hashn-redirect-refused' : response.status === 402 ? 'hashn-payment-refused' : 'hashn-provider-refused');
+  return { status: response.status, data, providerReceipt: privateHashnReceipt(receipt,credential) };
+}
diff --git a/src/hashn-offer-publication.mjs b/src/hashn-offer-publication.mjs
new file mode 100644
index 0000000..d5812bd
--- /dev/null
+++ b/src/hashn-offer-publication.mjs
@@ -0,0 +1,55 @@
+import { canonicalJson } from '@red-cup-engineering/json-services-section/canonical-json';
+import { hashnCredential, hashnRequest, UUID } from './hashn-client.mjs';
+
+const digest = async value => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',
+  new TextEncoder().encode(canonicalJson(value)))), n => n.toString(16).padStart(2, '0')).join('');
+
+// Source-owned Public offers are published explicitly; the clock cannot invoke
+// this operation. A publication never creates a deal or authorizes production.
+export async function publishHashnOffer({ descriptor, credential: rawCredential, custody, fetchImpl = fetch, now = () => Date.now() }) {
+  const credential = hashnCredential(rawCredential);
+  const listing = descriptor?.listing;
+  if (!credential || descriptor?.provider !== 'https://api.hashn.com' || descriptor.agentId !== credential.agentId ||
+      !UUID.test(descriptor.agentId) || !/^[a-z0-9][a-z0-9.-]{1,99}$/.test(listing?.name ?? '') ||
+      listing.path !== `listings/${listing.name}.md` || listing.convention !== 'agent-services' ||
+      !Number.isSafeInteger(descriptor.price?.amount) || descriptor.price.amount <= 0 || descriptor.price.currency !== 'USDC' ||
+      typeof listing.can !== 'string' || !listing.can || Object.hasOwn(listing, 'need') ||
+      listing.contact_method !== 'hashn knock' ||
+      listing.contact_info !== `POST https://api.hashn.com/agents/${credential.agentId}/knock`)
+    throw new TypeError('source-owned seller offer and matching admitted credential required');
+  const payloadSha256 = await digest(listing);
+  let state = await custody.getAttempt();
+  if (state?.payloadSha256 && state.payloadSha256 !== payloadSha256)
+    return { stage: 'publication-scope-held', newCashExpenseUsd: 0 };
+  // No blind replay after an unknown listing write. Native GET /listings and
+  // the public source URL reconcile it without another publication mutation.
+  if (state?.intent) return { stage: state.stage, newCashExpenseUsd: 0 };
+  state = { payloadSha256, agentId: credential.agentId, path: listing.path, at: new Date(now()).toISOString() };
+  try {
+    const me = await hashnRequest('/agents/me', { credential, fetchImpl, now });
+    if (me.data.agent_id !== credential.agentId) throw new Error('publication-account-mismatch');
+    const check = await hashnRequest('/listings/check', { method: 'POST', body: listing, credential, fetchImpl, now });
+    state.check = check.providerReceipt;
+    if (check.data.ok !== true || check.data.in_forest !== true || check.data.path !== listing.path ||
+        check.data.header?.can !== listing.can || check.data.header?.project !== listing.fields.project ||
+        check.data.header?.['payment.amount'] !== descriptor.price.amount ||
+        check.data.header?.['payment.currency'] !== descriptor.price.currency) {
+      state.stage = 'publication-check-held'; await custody.putAttempt(state);
+      return { stage: state.stage, newCashExpenseUsd: 0 };
+    }
+    state.intent = { method: 'POST', path: '/listings', body: listing };
+    state.stage = 'publication-intent';
+    await custody.putAttempt(state);
+    const result = await hashnRequest('/listings', { method: 'POST', body: listing, credential, fetchImpl, now });
+    state.receipt = result.providerReceipt;
+    state.stage = result.status === 201 ? 'publication-received' : 'publication-readback-required';
+    await custody.putAttempt(state);
+    return { stage: state.stage, receipt: result.data, newCashExpenseUsd: 0 };
+  } catch (error) {
+    state.stage = state.intent ? 'publication-outcome-held' : 'publication-precondition-held';
+    state.failure = { code: error.code ?? 'publication-failure', message: error.message,
+      ...(error.providerReceipt ? { providerReceipt: error.providerReceipt } : {}) };
+    await custody.putAttempt(state);
+    return { stage: state.stage, newCashExpenseUsd: 0 };
+  }
+}
diff --git a/src/hashn-provisioning.mjs b/src/hashn-provisioning.mjs
new file mode 100644
index 0000000..aea10af
--- /dev/null
+++ b/src/hashn-provisioning.mjs
@@ -0,0 +1,37 @@
+import { hashnCredential, hashnError, hashnRequest, UUID } from './hashn-client.mjs';
+
+export const HASHN_CREDENTIAL_ID = 'earning-loops.hashn-credential-json';
+const NAME = '561-group earning-loops';
+
+/** Explicit operator-only one-time provisioning. The caller supplies original
+ * durable attempt custody and sealed credential custody; no tokens are returned
+ * or written to the attempt receipt. This is never called by the Worker. */
+export async function provisionHashnAgent({ custody, fetchImpl = fetch, now = () => Date.now() } = {}) {
+  if (!custody || ['getAttempt','putAttempt','getCredential','putCredential'].some(k => typeof custody[k] !== 'function'))
+    throw new TypeError('durable attempt and sealed credential custody required');
+  let attempt = await custody.getAttempt();
+  const existingRaw = await custody.getCredential(HASHN_CREDENTIAL_ID);
+  const existing = hashnCredential(existingRaw);
+  if (existingRaw && !existing) throw hashnError('hashn-credential-invalid');
+  if (existing) {
+    const { data } = await hashnRequest('/agents/me', { credential: existing, fetchImpl, now });
+    if ((data.agent_id ?? data.id) !== existing.agentId || data.name !== NAME) throw hashnError('hashn-account-mismatch');
+    await custody.putAttempt({ ...attempt, stage: 'credential-received', agentId: existing.agentId, observedAt: new Date(now()).toISOString() });
+    return { stage: 'credential-received', agentId: existing.agentId, created: false, newCashExpenseUsd: 0 };
+  }
+  if (attempt) return { stage: 'signup-outcome-held', created: false, newCashExpenseUsd: 0 };
+  attempt = { stage: 'signup-intent', method: 'POST', path: '/agents', body: { name: NAME }, at: new Date(now()).toISOString() };
+  await custody.putAttempt(attempt); // write-ahead: an ambiguous signup is never repeated
+  try {
+    const { status, data, providerReceipt } = await hashnRequest('/agents', { method: 'POST', body: attempt.body, fetchImpl, now });
+    const credential = hashnCredential({ agentId: data.agent_id, apiToken: data.api_token });
+    if (status !== 201 || !UUID.test(data.agent_id ?? '') || !credential) throw Object.assign(hashnError('hashn-signup-response-invalid'),{providerReceipt});
+    await custody.putCredential(HASHN_CREDENTIAL_ID, credential); // original seal before a success receipt
+    await custody.putAttempt({ ...attempt, stage: 'credential-received', agentId: credential.agentId, observedAt: new Date(now()).toISOString() });
+    return { stage: 'credential-received', agentId: credential.agentId, created: true, newCashExpenseUsd: 0 };
+  } catch (error) {
+    await custody.putAttempt({ ...attempt, stage: 'signup-outcome-held', code: /^hashn-[a-z-]+$/.test(error.code ?? '') ? error.code : 'hashn-custody-failure',
+      ...(error.providerReceipt ? { providerReceipt: error.providerReceipt } : {}) });
+    return { stage: 'signup-outcome-held', created: false, newCashExpenseUsd: 0 };
+  }
+}
